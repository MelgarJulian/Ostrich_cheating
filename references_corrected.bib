	file = {Full Text:C\:\\Users\\admin\\Zotero\\storage\\ELLJK3KS\\Granato et al. - 2018 - Low spatial structure and selection against secreted virulence factors attenuates pathogenicity in P.pdf:application/pdf;Snapshot:C\:\\Users\\admin\\Zotero\\storage\\H5STDVEH\\s41396-018-0231-9.html:text/html},
}

