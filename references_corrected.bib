@article{wadeEvolutionCheatingSelfish1980,
	title = {The evolution of cheating and selfish behavior},
	volume = {7},
	issn = {0340-5443, 1432-0762},
	url = {http://link.springer.com/10.1007/BF00299360},
	doi = {10.1007/BF00299360},
