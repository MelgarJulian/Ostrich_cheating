@article{ozkaya2018,
	title = {Cheating on {Cheaters} {Stabilizes} {Cooperation} in \textit{{Pseudomonas} aeruginosa}},
	volume = {28},
	issn = {0960-9822},
	url = {https://www.sciencedirect.com/science/article/pii/S0960982218305657},
	doi = {10.1016/j.cub.2018.04.093},
	abstract = {Bacterial cooperation can be disrupted by non-producers that can profit from public goods without paying their production cost. A cheater can increase in frequency, exhausting the public good and causing a population collapse. Here, we investigate how interactions among two cheaters for distinct social traits influence the short- and long-term dynamics of polymorphic populations. Using as a model Pseudomonas aeruginosa and its extensively studied social traits, production of the siderophore pyoverdine, and the quorum-sensing regulated elastase, we analyzed the social dynamics of polymorphic populations under conditions where the two traits are required for optimal growth. We show that cheaters for either trait compete with both the wild-type and each other and that mutants for pyoverdine production can prevent a drastic population collapse caused by quorum-sensing cheaters. A simple mathematical model suggests that the observed social dynamics are determined by the ratio of the costs of each social trait, such that the mutant, which avoids paying the highest cost, dominates the population; in contrast, mean fitness of the population is determined by the difference between the benefits and the costs of the social traits. Finally, we demonstrate how quorum-sensing regulation can avoid the full loss of cooperation.},
	number = {13},
	urldate = {2026-05-22},
	journal = {Current Biology},
	author = {Özkaya, Özhan and Balbontín, Roberto and Gordo, Isabel and Xavier, Karina B.},
	month = jul,
	year = {2018},
	keywords = {cooperation, public goods, tragedy of the commons, cheating, elastase, public goods dilemma, pyoverdine, quorum sensing, sociomicrobiology},
	pages = {2070--2080.e6},
	file = {PDF:C\:\\Users\\admin\\Zotero\\storage\\EQGV2Z28\\Özkaya et al. - 2018 - Cheating on Cheaters Stabilizes Cooperation in Pseudomonas aeruginosa.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\admin\\Zotero\\storage\\8RRBSYBY\\S0960982218305657.html:text/html},
}

@article{granato2018,
