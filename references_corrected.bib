	pages = {10--12},
	file = {Full Text PDF:C\:\\Users\\admin\\Zotero\\storage\\UAXMEIKN\\Martin - 2011 - Cutadapt removes adapter sequences from high-throughput sequencing reads.pdf:application/pdf},
